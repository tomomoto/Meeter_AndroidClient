<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <RelativeLayout
            android:id="@+id/newEventLayoutLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:background="@drawable/edit_text_background_border">

            <TextView
                android:id="@+id/newEventLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/create_event"
                android:inputType="none"
                android:textAlignment="center"
                android:textSize="20sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/event_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/newEventLayoutLabel"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:background="@drawable/edit_text_background_border">

            <EditText
                android:id="@+id/newEventNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/name"
                android:textAlignment="center"
                android:textSize="20sp" />
        </RelativeLayout>

        <!--<RelativeLayout
                    android:id="@+id/new_event_city_RL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/event_name_layout"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/edit_text_background_border">

                    <EditText
                        android:id="@+id/new_event_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="50dp"
                        android:hint="@string/city"
                        android:textAlignment="center"
                        android:textSize="20sp" />
                </RelativeLayout>-->

        <RelativeLayout
            android:id="@+id/new_event_description_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/event_name_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:background="@drawable/edit_text_background_border">

            <EditText
                android:id="@+id/newEventDescriptionEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/description"
                android:textAlignment="center"
                android:textSize="20sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/place_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/new_event_description_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:background="@drawable/edit_text_background_border">

            <EditText
                android:id="@+id/newEventLatitudeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/latitude"
                android:inputType="text"
                android:textAlignment="center"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/newEventLongitudeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventLatitudeEditText"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/longitude"
                android:inputType="text"
                android:textAlignment="center"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/place_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/newEventLongitudeEditText"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">

                <Button
                    android:id="@+id/newEventCurrentPlaceBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/current"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/newEventOtherPlaceBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/map"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/date_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/place_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:background="@drawable/edit_text_background_border">


            <EditText
                android:id="@+id/newEventStartsDateEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/starts"
                android:inputType="date"
                android:textAlignment="center"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/newEventStartsDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventStartsDateEditText"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="Date validity"
                android:textAlignment="center"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/date_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventStartsDateTextView"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="horizontal"
                android:paddingTop="5dp">

                <Button
                    android:id="@+id/newEventStartsCurrentDateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/today"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/newEventStartsOtherDateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/other2"
                    android:textAllCaps="false" />
            </LinearLayout>

            <EditText
                android:id="@+id/newEventStartsTimeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/date_buttons_layout"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/starting_time"
                android:inputType="time"
                android:textAlignment="center"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/start_time_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventStartsTimeEditText"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="horizontal"
                android:paddingTop="5dp">

                <Button
                    android:id="@+id/newEventStartsCurrentTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/now"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/newEventStartsOtherTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/other"
                    android:textAllCaps="false" />
            </LinearLayout>

            <EditText
                android:id="@+id/newEventEndsDateEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/start_time_buttons_layout"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/ends"
                android:inputType="date"
                android:textAlignment="center"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/newEventEndsDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventEndsDateEditText"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="Date validity"
                android:textAlignment="center"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/end_date_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventEndsDateTextView"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="horizontal"
                android:paddingTop="5dp">

                <Button
                    android:id="@+id/newEventEndsCurrentDateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/today"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/newEventEndsOtherDateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/other2"
                    android:textAllCaps="false" />
            </LinearLayout>

            <EditText
                android:id="@+id/newEventEndsTimeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/end_date_buttons_layout"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/ending_time"
                android:inputType="time"
                android:textAlignment="center"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/end_time_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/newEventEndsTimeEditText"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:orientation="horizontal"
                android:paddingTop="5dp">

                <Button
                    android:id="@+id/newEventEndsCurrentTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/now"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/newEventEndsOtherTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/other"
                    android:textAllCaps="false" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/city_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/date_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:background="@drawable/edit_text_background_border">

            <EditText
                android:id="@+id/city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="50dp"
                android:hint="@string/city"
                android:textAlignment="center"
                android:textSize="20sp" />
        </RelativeLayout>

        <Button
            android:id="@+id/newEventCreateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/city_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="47dp"
            android:enabled="false"
            android:text="@string/create_event"
            android:textAllCaps="false" />
    </RelativeLayout>
</ScrollView>
