<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <RelativeLayout
        android:id="@+id/profile_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="170sp"
            android:layout_marginTop="29dp"
            android:adjustViewBounds="true"
            android:contentDescription="content description..."
            android:src="@drawable/user_612x612" />

        <!-- Имя и фамилия -->
        <TextView
            android:id="@+id/user_full_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/photo"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp"
            android:text="Имя Фамилия"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Пол -->
        <TextView
            android:id="@+id/user_gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/user_full_name"
            android:paddingBottom="4dp"
            android:text="Пол" />

        <!-- День рождения -->
        <TextView
            android:id="@+id/user_birthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/user_gender"
            android:paddingBottom="4dp"
            android:text="Дата рождения" />

        <!-- Информация о пользователе -->
        <TextView
            android:id="@+id/user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/user_birthday"
            android:paddingBottom="12dp"
            android:text="Информация о пользователе" />

        <!-- Кнопка Подписаться/Отписаться -->
        <Button
            android:id="@+id/subscribe_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/user_info"
            android:layout_marginBottom="16dp"
            android:text="Loading..." />

        <!-- Заголовок: События -->
        <TextView
            android:id="@+id/events_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/subscribe_button"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="События"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/events_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/events_label"
            android:layout_marginTop="40dp"
            android:animateLayoutChanges="false"
            android:background="#C0DEEF"
            android:gravity="center"
            android:nestedScrollingEnabled="false"
            android:numColumns="2"
            android:overScrollMode="never"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp"
            tools:listitem="@layout/card_item" />

    </RelativeLayout>
</ScrollView>