<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c0deef">
    <!--
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
    -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        tools:context=".context.user.activity.UserActivity">
        <!--removed^: android:padding="50dp" -->
        <TextView
            android:id="@+id/informationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="50dp"
            android:hint="@string/user_information"
            android:inputType="none"
            android:textAlignment="center"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="170sp"
            android:layout_below="@+id/informationLabel"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="29dp"
            android:adjustViewBounds="true"
            android:contentDescription="content description..."
            android:src="@drawable/user_612x612" />
        <!--app:srcCompat="@drawable/ic_launcher"
        tools:src="@tools:sample/backgrounds/scenic" -->

        <!-- Кнопка Подписаться/Отписаться -->
        <Button
            android:id="@+id/subscribeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/photo"
            android:layout_marginStart="25dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginBottom="16dp"
            android:text="Subscribe"
            android:textAllCaps="false"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/subs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/subscribeBtn"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subscribers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_selected"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/subscribers"
                android:textSize="20sp" />
            <!--android:textColor="@color/white"-->

            <TextView
                android:id="@+id/subscriptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_button_unselected"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/subscriptions"
                android:textSize="20sp" />
            <!--android:textColor="@color/gray"-->
        </LinearLayout>
        <!--
        <TextView
            android:id="@+id/profile_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/subs"
            android:layout_marginTop="15dp"
            android:text="@string/profile_user_id"
            android:textSize="20sp"
            android:textStyle="bold" />
        -->
        <LinearLayout
            android:id="@+id/name_surname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/subs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="Name"
                android:text="Name"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/surname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="Surname"
                android:text="Surname"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/birthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/name_surname"
            android:layout_marginTop="15sp"
            android:gravity="center"
            android:hint="Birthday"
            android:text="Birthday"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/age_and_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/birthday"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15sp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/profile_gender"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15sp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/profile_age"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/age_and_gender"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:hint="Information"
            android:text="Information"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/info"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:hint="@string/user_events"
            android:inputType="none"
            android:textAlignment="center"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/events"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/eventsLabel"
            android:layout_marginTop="40dp"
            android:animateLayoutChanges="false"
            android:background="@color/c0deef"
            android:gravity="center"
            android:nestedScrollingEnabled="false"
            android:numColumns="2"
            android:overScrollMode="never"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp"
            tools:listitem="@layout/card_item" />
    </RelativeLayout>
</ScrollView>
